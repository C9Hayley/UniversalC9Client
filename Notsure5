section("Aimlock", function()
	local enabled, target = false, nil
	local maxDistance = 500

	local function valid(p)
		if p == localPlayer then return false end
		if localPlayer.Team ~= nil and p.Team == localPlayer.Team then return false end
		local c = p.Character
		if not c then return false end
		local hum = c:FindFirstChildOfClass("Humanoid")
		return hum ~= nil and hum.Health > 0 and c:FindFirstChild("HumanoidRootPart") ~= nil
	end

	local function closest()
		local myRoot = getRoot()
		if not myRoot then return nil end
		local best, bestDist = nil, maxDistance
		for _, p in ipairs(Players:GetPlayers()) do
			if valid(p) then
				local d = (p.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
				if d < bestDist then best, bestDist = p, d end
			end
		end
		return best
	end

	local function step()
		if not target or not valid(target) then target = closest() end
		local head = target and target.Character and target.Character:FindFirstChild("Head")
		if head then
			local cam = Workspace.CurrentCamera
			cam.CFrame = CFrame.lookAt(cam.CFrame.Position, head.Position)
		end
	end

	local function setEnabled(v)
		enabled, target = v, nil
		if v then
			RunService:BindToRenderStep("C9Aimlock", Enum.RenderPriority.Camera.Value + 1, step)
		else
			pcall(function() RunService:UnbindFromRenderStep("C9Aimlock") end)
		end
		aimlockBtn.Text = v and "AIMLOCK: ON" or "AIMLOCK: OFF"
	end

	aimlockBtn.MouseButton1Click:Connect(function() setEnabled(not enabled) end)
	onKill(function() setEnabled(false) end)
end)

