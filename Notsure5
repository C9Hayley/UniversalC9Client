section("Anti-Fling", function()
	local enabled = false
	local conn
	local original = {} -- part -> {CanCollide, CanTouch}

	local function protectPlayers()
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= localPlayer and player.Character then
				for _, part in ipairs(player.Character:GetDescendants()) do
					if part:IsA("BasePart") then
						if original[part] == nil then
							original[part] = { part.CanCollide, part.CanTouch }
						end
						part.CanCollide = false
						part.CanTouch = false
					end
				end
			end
		end
	end

	local function enable()
		if enabled then return end
		enabled = true
		conn = RunService.Stepped:Connect(protectPlayers)
		antiFlingBtn.Text = "Anti-Fling: ON"
	end

	local function disable()
		enabled = false
		if conn then
			conn:Disconnect()
			conn = nil
		end
		-- put other players' parts back how they were
		for part, values in pairs(original) do
			if part and part.Parent then
				part.CanCollide = values[1]
				part.CanTouch = values[2]
			end
		end
		table.clear(original)
		antiFlingBtn.Text = "Anti-Fling: OFF"
	end

	antiFlingBtn.MouseButton1Click:Connect(function()
		if enabled then disable() else enable() end
	end)

	onKill(disable)
end)

