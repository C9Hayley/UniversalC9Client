------------------------------------------------------------------------
-- Freecam (toggle with the button, hold right mouse to look)
------------------------------------------------------------------------
section("Freecam", function()
	local pi, clamp, exp, rad, sqrt, tan = math.pi, math.clamp, math.exp, math.rad, math.sqrt, math.tan

	local INPUT_PRIORITY = Enum.ContextActionPriority.High.Value
	local NAV_GAIN = Vector3.new(1, 1, 1) * 64
	local PAN_GAIN = Vector2.new(0.75, 1) * 8
	local FOV_GAIN = 300
	local PITCH_LIMIT = rad(90)
	local VEL_STIFFNESS, PAN_STIFFNESS, FOV_STIFFNESS = 1.5, 1.0, 4.0

	local Spring = {}
	Spring.__index = Spring
	function Spring.new(freq, pos)
		return setmetatable({ f = freq, p = pos, v = pos * 0 }, Spring)
	end
	function Spring:Update(dt, goal)
		local f = self.f * 2 * pi
		local p0, v0 = self.p, self.v
		local offset = goal - p0
		local decay = exp(-f * dt)
		self.p = goal + (v0 * dt - offset * (f * dt + 1)) * decay
		self.v = (f * dt * (offset * f - v0) + v0) * decay
		return self.p
	end
	function Spring:Reset(pos)
		self.p = pos
		self.v = pos * 0
	end

	local cameraPos, cameraRot, cameraFov = Vector3.new(), Vector2.new(), 70
	local velSpring = Spring.new(VEL_STIFFNESS, Vector3.new())
	local panSpring = Spring.new(PAN_STIFFNESS, Vector2.new())
	local fovSpring = Spring.new(FOV_STIFFNESS, 0)

	local keyboard = { W = 0, A = 0, S = 0, D = 0, E = 0, Q = 0, Up = 0, Down = 0 }
	local mouseDelta, mouseWheel, navSpeed = Vector2.new(), 0, 1

	local function velInput(dt)
		navSpeed = clamp(navSpeed + dt * (keyboard.Up - keyboard.Down) * 0.75, 0.01, 4)
		local k = Vector3.new(keyboard.D - keyboard.A, keyboard.E - keyboard.Q, keyboard.S - keyboard.W)
		local shift = UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
		return k * (navSpeed * (shift and 0.25 or 1))
	end
	local function panInput()
		local d = mouseDelta * (pi / 64)
		mouseDelta = Vector2.new()
		return d
	end
	local function fovInput()
		local w = mouseWheel
		mouseWheel = 0
		return w
	end

	local function onKey(_a, state, input)
		keyboard[input.KeyCode.Name] = state == Enum.UserInputState.Begin and 1 or 0
		return Enum.ContextActionResult.Sink
	end
	local function onMouseMove(_a, _b, input)
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			mouseDelta += Vector2.new(-input.Delta.Y, -input.Delta.X)
		end
		return Enum.ContextActionResult.Pass
	end
	local function onWheel(_a, _b, input)
		mouseWheel = -input.Position.Z
		return Enum.ContextActionResult.Sink
	end

	local function startCapture()
		ContextActionService:BindActionAtPriority("C9FreecamKeys", onKey, false, INPUT_PRIORITY,
			Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
			Enum.KeyCode.E, Enum.KeyCode.Q, Enum.KeyCode.Up, Enum.KeyCode.Down)
		ContextActionService:BindActionAtPriority("C9FreecamMouse", onMouseMove, false, INPUT_PRIORITY,
			Enum.UserInputType.MouseMovement)
		ContextActionService:BindActionAtPriority("C9FreecamWheel", onWheel, false, INPUT_PRIORITY,
			Enum.UserInputType.MouseWheel)
	end
	local function stopCapture()
		navSpeed = 1
		for k in pairs(keyboard) do keyboard[k] = 0 end
		mouseDelta, mouseWheel = Vector2.new(), 0
		ContextActionService:UnbindAction("C9FreecamKeys")
		ContextActionService:UnbindAction("C9FreecamMouse")
		ContextActionService:UnbindAction("C9FreecamWheel")
	end

	local function focusDistance(cf)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { localPlayer.Character }
		local r = Workspace:Raycast(cf.Position, cf.LookVector * 512, params)
		return r and (r.Position - cf.Position).Magnitude or 512
	end

	local function step(dt)
		local cam = Workspace.CurrentCamera
		local vel = velSpring:Update(dt, velInput(dt))
		local pan = panSpring:Update(dt, panInput())
		local fov = fovSpring:Update(dt, fovInput())

		local zoomFactor = sqrt(tan(rad(70 / 2)) / tan(rad(cameraFov / 2)))
		cameraFov = clamp(cameraFov + fov * FOV_GAIN * (dt / zoomFactor), 1, 120)
		cameraRot = cameraRot + pan * PAN_GAIN * (dt / zoomFactor)
		cameraRot = Vector2.new(clamp(cameraRot.X, -PITCH_LIMIT, PITCH_LIMIT), cameraRot.Y % (2 * pi))

		local cf = CFrame.new(cameraPos)
			* CFrame.fromOrientation(cameraRot.X, cameraRot.Y, 0)
			* CFrame.new(vel * NAV_GAIN * dt)
		cameraPos = cf.Position

		cam.CFrame = cf
		cam.Focus = cf * CFrame.new(0, 0, -focusDistance(cf))
		cam.FieldOfView = cameraFov
	end

	-- Saved player state (restored when freecam stops)
	local saved
	local coreGuis = { Backpack = true, Chat = true, Health = true, PlayerList = true }

	local function push()
		local cam = Workspace.CurrentCamera
		saved = {
			core = {}, guis = {},
			fov = cam.FieldOfView, camType = cam.CameraType,
			cframe = cam.CFrame, focus = cam.Focus,
			mouseIcon = UIS.MouseIconEnabled,
		}
		for name in pairs(coreGuis) do
			pcall(function()
				saved.core[name] = StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType[name])
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType[name], false)
			end)
		end
		-- hide other GUIs but keep this hub visible so the button still works
		for _, g in ipairs(playerGui:GetChildren()) do
			if g:IsA("ScreenGui") and g.Enabled and g ~= gui then
				saved.guis[#saved.guis + 1] = g
				g.Enabled = false
			end
		end
		cam.CameraType = Enum.CameraType.Scriptable
	end

	local function pop()
		if not saved then return end
		local cam = Workspace.CurrentCamera
		for name, v in pairs(saved.core) do
			pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType[name], v) end)
		end
		for _, g in ipairs(saved.guis) do
			if g.Parent then g.Enabled = true end
		end
		cam.FieldOfView = saved.fov
		cam.CameraType = saved.camType
		cam.CFrame = saved.cframe
		cam.Focus = saved.focus
		UIS.MouseIconEnabled = saved.mouseIcon
		saved = nil
	end

	local enabled = false

	local function setEnabled(v)
		if v == enabled then return end
		enabled = v
		if v then
			local cam = Workspace.CurrentCamera
			cameraRot = Vector2.new(cam.CFrame:ToEulerAnglesYXZ())
			cameraPos = cam.CFrame.Position
			cameraFov = cam.FieldOfView
			velSpring:Reset(Vector3.new())
			panSpring:Reset(Vector2.new())
			fovSpring:Reset(0)

			push()
			RunService:BindToRenderStep("C9Freecam", Enum.RenderPriority.Camera.Value, step)
			startCapture()
		else
			stopCapture()
			pcall(function() RunService:UnbindFromRenderStep("C9Freecam") end)
			pop()
		end
		freecamBtn.Text = v and "FREECAM: ON" or "FREECAM: OFF"
	end

	freecamBtn.MouseButton1Click:Connect(function() setEnabled(not enabled) end)
	onKill(function() setEnabled(false) end)
end)

