section("Follow player", function()
	local following, target, conn = false, nil, nil
	local FOLLOW_DISTANCE = 4

	local function stop()
		following, target = false, nil
		if conn then conn:Disconnect() conn = nil end
		followBtn.Text = "FOLLOW: OFF"
	end

	local function start()
		local p = findPlayer(followBox.Text, false)
