	tpBtn.MouseButton1Click:Connect(function()
		local target = findPlayer(tpBox.Text, false)
		if not target then return flash(tpBtn, "PLAYER NOT FOUND", idle) end

		local targetRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
		if not targetRoot then return flash(tpBtn, "NO CHARACTER", idle) end

		local root = getRoot()
		if root then
			root.CFrame = targetRoot.CFrame * CFrame.new(3, 0, 0)
		end
	end)
end)

