------------------------------------------------------------------------

-- runs each feature in its own pcall so one failure can't stop the rest
local function section(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn("[C9] " .. name .. " failed: " .. tostring(err))
	end
end
-- Matches username OR display name. Exact match first, then prefix match.
local function findPlayer(text, allowSelf)
	text = (text or ""):match("^%s*(.-)%s*$"):lower()
	if text == "" then return nil end

	for _, p in ipairs(Players:GetPlayers()) do
		if (allowSelf or p ~= localPlayer)
			and (p.Name:lower() == text or p.DisplayName:lower() == text) then
			return p
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if (allowSelf or p ~= localPlayer)
			and (p.Name:lower():sub(1, #text) == text
				or p.DisplayName:lower():sub(1, #text) == text) then
			return p
		end
	end

	return nil
end

local function flash(button, msg, restore)
	button.Text = msg
	task.delay(1.5, function()
		if button.Parent then button.Text = restore() end
	end)
end

