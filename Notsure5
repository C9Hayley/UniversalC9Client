section("Ride player", function()
	local riding, target, conn = false, nil, nil
	local HEIGHT_OFFSET = -0.15

	local function stop()
		riding, target = false, nil
		if conn then conn:Disconnect() conn = nil end

		local root, hum = getRoot(), getHumanoid()
		if root then
			root.Anchored = false
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
		if hum then
			hum.Sit = false
			hum.PlatformStand = false
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
		rideBtn.Text = "RIDE: OFF"
	end

	local function start()
		local p = findPlayer(rideBox.Text, false)
		if not p then
			return flash(rideBtn, "PLAYER NOT FOUND", function() return "RIDE: OFF" end)
		end

		target, riding = p, true
		rideBtn.Text = "RIDE: ON"

		conn = RunService.Heartbeat:Connect(function()
			if not target or target.Parent ~= Players then
				stop()
				return
			end

			local root, hum = getRoot(), getHumanoid()
			local head = target.Character and target.Character:FindFirstChild("Head")

			if root and hum and head then
				local offset = head.Size.Y / 2 + root.Size.Y / 2 + HEIGHT_OFFSET
				root.CFrame = head.CFrame * CFrame.new(0, offset, 0)
				root.AssemblyLinearVelocity = head.AssemblyLinearVelocity
				root.AssemblyAngularVelocity = Vector3.zero
				hum.Sit = true
			end
		end)
	end

	rideBtn.MouseButton1Click:Connect(function()
		if riding then stop() else start() end
	end)

	track(Players.PlayerRemoving:Connect(function(p)
		if p == target then stop() end
	end))
	track(localPlayer.CharacterAdded:Connect(function()
		if riding then stop() end
	end))
	onKill(stop)
end)

------------------------------------------------------------------------
-- Flight (character flight with speed box, and vehicle flight)
------------------------------------------------------------------------
local function makeFlight(button, name, getSpeed, useVehicle)
	local flying = false
	local conn, bv, bg, hum, moved

	local function stop()
		flying = false
		if conn then conn:Disconnect() conn = nil end
		if bv then bv:Destroy() bv = nil end
		if bg then bg:Destroy() bg = nil end
		if hum and hum.Parent then
			hum.AutoRotate = true
			hum.PlatformStand = false
		end
		button.Text = name .. ": OFF"
	end

	local function start()
		local char = localPlayer.Character
		hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not hum or not root then return end

		-- vehicle mode: move the whole vehicle if seated, otherwise fly the character
		local part = root
		if useVehicle and hum.SeatPart then
			part = hum.SeatPart.AssemblyRootPart or hum.SeatPart
		end
		if part == root then hum.AutoRotate = false end

		flying = true
		button.Text = name .. ": ON"

		bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bv.Velocity = Vector3.zero
		bv.Parent = part

		bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		bg.P = 1e4
		bg.CFrame = part.CFrame
		bg.Parent = part

		conn = RunService.RenderStepped:Connect(function()
			if not flying or not part.Parent then
				stop()
				return
			end

			local cam = Workspace.CurrentCamera
			local dir = Vector3.zero

			-- don't fly while typing in a textbox
			if not UIS:GetFocusedTextBox() then
				if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
				if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
			end

			bv.Velocity = dir.Magnitude > 0 and dir.Unit * getSpeed() or Vector3.zero
			bg.CFrame = cam.CFrame
		end)
	end

	button.MouseButton1Click:Connect(function()
		if flying then stop() else start() end
	end)
	track(localPlayer.CharacterAdded:Connect(function()
		if flying then stop() end
	end))
	onKill(stop)
end

