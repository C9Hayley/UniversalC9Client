------------------------------------------------------------------------
-- Cleanup bookkeeping (used by the kill switch)
------------------------------------------------------------------------
local connections, killFns = {}, {}
local function track(c) connections[#connections + 1] = c return c end
local function onKill(fn) killFns[#killFns + 1] = fn end

------------------------------------------------------------------------
