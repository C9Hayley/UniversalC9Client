section("ESP", function()
	local enabled = false
	local entries = {}
	local maxDistance = 1000
	local updateConn
	local DEFAULT_COLOR = Color3.fromRGB(255, 60, 60)

	local opts = {
		boxes = true, names = true, distance = true, health = true,
		tracers = false, chams = false, teamCheck = false, teamColors = true,
	}

	local optionList = {
		{ "boxes", "Boxes" },
		{ "names", "Names" },
		{ "distance", "Distance" },
		{ "health", "Health" },
		{ "tracers", "Tracers" },
		{ "chams", "Chams (fill)" },
		{ "teamCheck", "Hide teammates" },
		{ "teamColors", "Team colors" },
	}

	-- Options panel (child of the hub, so it moves with it)
	local optFrame = Instance.new("Frame")
	optFrame.BackgroundColor3 = Color3.fromRGB(27, 27, 27)
	optFrame.BackgroundTransparency = 0.2
	optFrame.BorderSizePixel = 0
	optFrame.Position = UDim2.fromOffset(412, 0)
	optFrame.Size = UDim2.fromOffset(170, 34 + #optionList * 30 + 56)
	optFrame.Visible = false
	optFrame.Parent = main
	corner(optFrame)

	local header = Instance.new("TextLabel")
	header.BackgroundTransparency = 1
	header.Position = UDim2.fromOffset(0, 4)
	header.Size = UDim2.fromOffset(170, 26)
	header.Font = Enum.Font.Fantasy
	header.Text = "ESP Options"
	header.TextColor3 = WHITE
	header.TextSize = 20
	header.Parent = optFrame

	local ON = Color3.fromRGB(40, 120, 60)
	for i, item in ipairs(optionList) do
		local key, label = item[1], item[2]
		local b = newButton(optFrame, "", 10, 34 + (i - 1) * 30, 150, 26)
		local function refresh()
			b.Text = label .. ": " .. (opts[key] and "ON" or "OFF")
			b.BackgroundColor3 = opts[key] and ON or DARK
		end
		refresh()
		b.MouseButton1Click:Connect(function()
			opts[key] = not opts[key]
			refresh()
		end)
	end

	local distLabel = Instance.new("TextLabel")
	distLabel.BackgroundTransparency = 1
	distLabel.Position = UDim2.fromOffset(10, 34 + #optionList * 30)
	distLabel.Size = UDim2.fromOffset(150, 16)
	distLabel.Font = Enum.Font.GothamBold
	distLabel.Text = "Max distance (studs)"
	distLabel.TextColor3 = WHITE
	distLabel.TextSize = 12
	distLabel.Parent = optFrame

	local distBox = Instance.new("TextBox")
	distBox.BackgroundColor3 = DARK
	distBox.BorderSizePixel = 0
	distBox.Position = UDim2.fromOffset(10, 34 + #optionList * 30 + 18)
	distBox.Size = UDim2.fromOffset(150, 26)
	distBox.Font = Enum.Font.GothamBold
	distBox.Text = tostring(maxDistance)
	distBox.ClearTextOnFocus = false
	distBox.TextColor3 = WHITE
	distBox.TextSize = 13
	distBox.Parent = optFrame
	corner(distBox)

	distBox.FocusLost:Connect(function()
		local n = tonumber(distBox.Text)
		if n then maxDistance = math.clamp(n, 50, 100000) end
		distBox.Text = tostring(maxDistance)
	end)

	espOptBtn.MouseButton1Click:Connect(function()
		optFrame.Visible = not optFrame.Visible
	end)

	-- ESP objects
	local function teamColor(p)
		return p.Team and p.Team.TeamColor.Color or DEFAULT_COLOR
	end

	local function remove(p)
		local e = entries[p]
		if e then
			for _, item in ipairs(e.items) do item:Destroy() end
			entries[p] = nil
		end
	end

	local function create(p)
		if p == localPlayer then return end
		remove(p)

		local char = p.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
		local head = char:FindFirstChild("Head")
		if not hum or not root or not head then return end

		-- chams (fill + outline)
		local highlight = Instance.new("Highlight")
		highlight.Adornee = char
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.Enabled = false
		highlight.Parent = char

		-- 3D box
		local box = Instance.new("SelectionBox")
		box.Adornee = char
		box.LineThickness = 0.04
		box.SurfaceTransparency = 1
		box.Visible = false
		box.Parent = char

		-- name / distance / health text
		local billboard = Instance.new("BillboardGui")
		billboard.Adornee = head
		billboard.Size = UDim2.fromOffset(200, 60)
		billboard.StudsOffset = Vector3.new(0, 3.5, 0)
		billboard.AlwaysOnTop = true
		billboard.Enabled = false
		billboard.Parent = head

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.RichText = true
		label.Text = ""
		label.TextColor3 = WHITE
		label.TextStrokeTransparency = 0
		label.TextYAlignment = Enum.TextYAlignment.Bottom
		label.Font = Enum.Font.SourceSansBold
		label.TextSize = 15
		label.Parent = billboard

		-- tracer
		local startAtt = Instance.new("Attachment")
		startAtt.Parent = Workspace.Terrain

		local endAtt = Instance.new("Attachment")
		endAtt.Parent = root

		local beam = Instance.new("Beam")
		beam.Attachment0 = startAtt
		beam.Attachment1 = endAtt
		beam.FaceCamera = true
		beam.Width0 = 0.08
		beam.Width1 = 0.08
		beam.Transparency = NumberSequence.new(0)
		beam.Enabled = false
		beam.Parent = Workspace.Terrain

		entries[p] = {
			char = char, hum = hum, root = root,
			highlight = highlight, box = box, billboard = billboard,
			label = label, beam = beam, startAtt = startAtt,
			items = { highlight, box, billboard, startAtt, endAtt, beam },
		}
	end

	local function update()
		local cam = Workspace.CurrentCamera
		local camPos = cam.CFrame.Position
		local origin = cam.CFrame * Vector3.new(0, -1.5, -3)

		for p, e in pairs(entries) do
			local alive = e.char.Parent ~= nil and e.root.Parent ~= nil and e.hum.Health > 0
			local dist = alive and (e.root.Position - camPos).Magnitude or 0
			local show = alive and dist <= maxDistance

			if show and opts.teamCheck and localPlayer.Team ~= nil and p.Team == localPlayer.Team then
				show = false
			end

			local color = opts.teamColors and teamColor(p) or DEFAULT_COLOR

			e.box.Visible = show and opts.boxes
			e.highlight.Enabled = show and opts.chams
			e.beam.Enabled = show and opts.tracers

			local lines = {}
			if show then
				e.box.Color3 = color
				e.highlight.FillColor = color
				e.highlight.OutlineColor = color
				e.beam.Color = ColorSequence.new(color)
				e.startAtt.WorldPosition = origin

				if opts.names then
					lines[#lines + 1] = string.format('<font color="#%s">%s</font>', color:ToHex(), p.Name)
				end
				if opts.distance then
					lines[#lines + 1] = string.format("[%d studs]", math.floor(dist + 0.5))
				end
				if opts.health then
					local hp, maxHp = e.hum.Health, math.max(e.hum.MaxHealth, 1)
					local frac = math.clamp(hp / maxHp, 0, 1)
					local hc = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), frac)
					lines[#lines + 1] = string.format('<font color="#%s">HP %d/%d</font>',
						hc:ToHex(), math.floor(hp + 0.5), math.floor(maxHp + 0.5))
				end
			end

			e.label.Text = table.concat(lines, "\n")
			e.billboard.Enabled = show and #lines > 0
		end
	end

	local function hook(p)
		if p == localPlayer then return end
		track(p.CharacterAdded:Connect(function()
			task.wait(0.5)
			if enabled then create(p) end
		end))
		track(p.CharacterRemoving:Connect(function() remove(p) end))
	end

	for _, p in ipairs(Players:GetPlayers()) do hook(p) end
	track(Players.PlayerAdded:Connect(hook))
	track(Players.PlayerRemoving:Connect(remove))

	local function setEnabled(v)
		enabled = v
		if v then
			for _, p in ipairs(Players:GetPlayers()) do create(p) end
			updateConn = RunService.RenderStepped:Connect(update)
		else
			if updateConn then updateConn:Disconnect() updateConn = nil end
			for p in pairs(entries) do remove(p) end
		end
		espBtn.Text = v and "ESP: ON" or "ESP: OFF"
	end

	espBtn.MouseButton1Click:Connect(function() setEnabled(not enabled) end)
	onKill(function() setEnabled(false) end)
end)

------------------------------------------------------------------------
-- HBE (resizes other players' HumanoidRootPart so it actually affects hits)
------------------------------------------------------------------------
section("HBE", function()
	local enabled = false
	local data = {}
	local conn

	local function restore(p)
		local d = data[p]
		if d then
			if d.root and d.root.Parent then
				d.root.Size = d.size
				d.root.Transparency = d.transparency
				d.root.Material = d.material
				d.root.Color = d.color
				d.root.CanCollide = d.canCollide
			end
			data[p] = nil
		end
	end

	local function apply(p)
		if p == localPlayer then return end
		local char = p.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local d = data[p]
		if d and d.root ~= root then data[p] = nil d = nil end -- respawned
		if not d then
			data[p] = {
				root = root, size = root.Size, transparency = root.Transparency,
				material = root.Material, color = root.Color, canCollide = root.CanCollide,
			}
		end

		root.Size = HITBOX_SIZE
		root.Transparency = 0.6
		root.Material = Enum.Material.ForceField
		root.Color = p.Team and p.Team.TeamColor.Color or WHITE
		root.CanCollide = false
	end

	local function setEnabled(v)
		enabled = v
		if v then
			conn = RunService.Stepped:Connect(function()
				for _, p in ipairs(Players:GetPlayers()) do apply(p) end
			end)
		else
			if conn then conn:Disconnect() conn = nil end
			for p in pairs(data) do restore(p) end
		end
		hbeBtn.Text = v and "HBE: ON" or "HBE: OFF"
	end

	track(Players.PlayerRemoving:Connect(function(p) data[p] = nil end))
	hbeBtn.MouseButton1Click:Connect(function() setEnabled(not enabled) end)
	onKill(function() setEnabled(false) end)
end)

------------------------------------------------------------------------
-- Noclip
------------------------------------------------------------------------
section("Noclip", function()
	local enabled = false
	local conn
	local original = {}

	local function setEnabled(v)
		enabled = v
		if v then
			conn = RunService.Stepped:Connect(function()
				local char = localPlayer.Character
				if not char then return end
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						if original[part] == nil then original[part] = part.CanCollide end
						part.CanCollide = false
					end
				end
			end)
		else
			if conn then conn:Disconnect() conn = nil end
			for part, value in pairs(original) do
				if part and part.Parent then part.CanCollide = value end
			end
			table.clear(original)
		end
		noclipBtn.Text = v and "NOCLIP: ON" or "NOCLIP: OFF"
	end

	noclipBtn.MouseButton1Click:Connect(function() setEnabled(not enabled) end)
	track(localPlayer.CharacterAdded:Connect(function()
		if enabled then setEnabled(false) end
	end))
	onKill(function() setEnabled(false) end)
end)

